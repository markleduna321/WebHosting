APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Privileged MySQL account used ONLY to provision student databases.
# On WAMP this is usually root with an empty password. Never expose it to the client.
DB_ADMIN_USERNAME=root
DB_ADMIN_PASSWORD=

# Student database provisioning
STUDENT_DB_HOST=127.0.0.1
STUDENT_DB_PORT=3306
STUDENT_DB_PREFIX=stu
STUDENT_DB_GRANT_HOST=localhost
STUDENT_DB_MAX_PER_USER=3
STUDENT_DB_QUOTA_MB=256
# Local (WAMP): check C:\wamp64\alias\ for the exact alias, e.g. http://localhost/phpmyadmin5.2.3
# Production (CloudPanel / VPS): use the CloudPanel phpMyAdmin URL, e.g. https://<server-ip>:8443/pma
# Leaving this as localhost in production will redirect users to the CloudPanel login page!
STUDENT_DB_PHPMYADMIN_URL=http://localhost/phpmyadmin

# PayMongo (QR Ph checkout)
# The webhook secret is shown when you create the endpoint in the PayMongo
# dashboard. It is NOT your secret API key.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_LIVEMODE=false
PAYMONGO_QR_EXPIRY_SECONDS=1800

# GitHub OAuth — create an OAuth App at github.com/settings/developers and fill these in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Deployment targets (examples)
# Configure these per-environment (staging/production) in your CI or host
DEPLOYMENT_ENV=local
APP_URL_STAGING=https://staging.example.com
APP_URL_PRODUCTION=https://example.com

# Sanctum / Cookies
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SESSION_DOMAIN=localhost

# Optional monitoring / 3rd party
SENTRY_DSN=

# Frontend API base (useful for deployed builds)
VITE_API_URL=http://localhost/api

